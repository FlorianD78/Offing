# Copier en .env.local pour `vercel dev` (ne jamais committer les vraies valeurs)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé secrète (sb_secret_...) — ou l'ancienne clé service_role via SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SECRET_KEY=sb_secret_xxx
# Chaîne aléatoire : protège /api/cron (Vercel l'envoie en Authorization: Bearer)
CRON_SECRET=change-me
# Chaîne aléatoire : sel pour hacher les IP (limite de création de profils)
IP_SALT=change-me
# Jours de conservation des chronos et traces
KEEP_DAYS=30
